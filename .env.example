# Lokální konfigurace. Kopíruj do .env: cp .env.example .env

# Port serveru (CodeNOW runtime port je 3000 viz .codenow.yaml)
PORT=3000

# Prefix base path za reverzní proxy (nginx). Prázdné = kořen (/).
BASE_PATH=

# Výchozí využití PaaS v % (20/40/60/80/100) pro přepočet ceny.
PAAS_UTILIZATION=40

# API klíč Google Cloud pro Cloud Billing Catalog API (volitelné).
# Bez něj se katalog instancí pro GCP při "Obnovit ceny z cloudu" přeskočí.
# https://console.cloud.google.com/apis/credentials → Create credentials → API key
GCP_API_KEY=